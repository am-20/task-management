# Copy this file to .env.local for local development, and add the same two
# values as environment variables in your hosting provider.
# Both come from Supabase → Project Settings → API Keys (and Data API for the URL).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
